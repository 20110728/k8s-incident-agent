{
  "schema_version": "v1",
  "profile_id": "agent-demo.order-service",
  "revision": "1",
  "namespace": "agent-demo",
  "service_name": "order-service",
  "deployment_name": "order-service",
  "container_name": "order-service",
  "owner": {
    "team": "demo-maintainer",
    "contact": "项目维护者（Demo 本地责任人）"
  },
  "config_source": "infra/demo-app/baseline.yaml",
  "application": {
    "version": "day21-nginx-v1",
    "images": {
      "order-service": "nginx:1.30.4-alpine"
    }
  },
  "expected_selector": {
    "app": "order-service"
  },
  "readiness_probe": {
    "path": "/healthz",
    "port": "http",
    "scheme": "HTTP"
  },
  "liveness_probe": {
    "path": "/healthz",
    "port": "http",
    "scheme": "HTTP"
  },
  "business_checks": [
    {
      "check_id": "legacy-demo-root",
      "method": "GET",
      "path": "/",
      "port": 80,
      "scheme": "HTTP",
      "expected_status": 200,
      "expected_json_subset": {
        "message": "order-service is running"
      },
      "timeout_seconds": 3,
      "max_response_bytes": 16384,
      "follow_redirects": false,
      "read_only": true
    }
  ]
}
