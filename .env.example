# PostgreSQL container configuration.
POSTGRES_USER=incident_agent
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=incident_agent
POSTGRES_PORT=5433

# Stable external Docker volume name.
POSTGRES_VOLUME_NAME=postgres_incident-agent-postgres

# The password in this URL must be URL-encoded when it contains
# reserved URL characters.
PGVECTOR_URL=postgresql+psycopg://incident_agent:replace-with-a-strong-password@127.0.0.1:5433/incident_agent

# OpenAI-compatible LLM and Embedding endpoint.
DASHSCOPE_API_KEY=replace-with-your-api-key
DASHSCOPE_BASE_URL=https://replace-with-your-openai-compatible-endpoint/v1

LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
RUNBOOK_COLLECTION=k8s_runbooks_v1

# API configuration.
INCIDENT_AGENT_API_ENVIRONMENT=production
INCIDENT_AGENT_API_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
INCIDENT_AGENT_DB_CONNECT_TIMEOUT_SECONDS=5

# Strict LangGraph checkpoint deserialization must remain enabled.
LANGGRAPH_STRICT_MSGPACK=true

# Local kind context used by the container-mounted kubeconfig.
KUBERNETES_CONTEXT=kind-incident-agent